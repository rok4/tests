meta {
  name: Mise à jour de la couche 'bdortho'
  type: http
  seq: 2
}

put {
  url: {{endpoint}}/admin/layers/OI.OrthoimageCoverage
  body: json
  auth: none
}

body:json {
  {
    "title": "OI.OrthoimageCoverage",
    "abstract": "OI.OrthoimageCoverage",
    "keywords": ["OI.OrthoimageCoverage"],
    "pyramids": [
      {
        "path": "s3://pyramids/BDORTHO.json",
        "top_level": "0",
        "bottom_level": "15"
      }
    ],
    "wms": {
      "enabled": true,
      "crs": ["EPSG:4326"]
    },
    "wmts": {
      "enabled": true
    },
    "tms": {
      "enabled": false
    },
    "tiles": {
      "enabled": true
    },
    "styles": [
      "inspire"
    ],
    "metadata": [
      {
          "url": "http://metadata.ign.fr/OI.OrthoimageCoverage.xml",
          "type": "ISO19115:2003",
          "format": "application/xml"
      }
    ],
    "get_feature_info": {
      "type": "PYRAMID"
    }
  }
}

assert {
  res.status: eq 204
}

docs {
  Mise en conformité Inspire : ajout d'une métadonnée et style Inspre par défaut
}
