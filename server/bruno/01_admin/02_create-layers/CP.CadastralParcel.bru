meta {
  name: Création de la couche 'CP.CadastralParcel'
  type: http
  seq: 1
}

post {
  url: {{endpoint}}/admin/layers/CP.CadastralParcel
  body: json
  auth: none
}

headers {
  X-Rok4-Secret: secret
}

body:json {
  {
    "title": "CP.CadastralParcel",
    "abstract": "CP.CadastralParcel",
    "keywords": ["CP.CadastralParcel"],
    "pyramids": [
      {
        "path": "s3://pyramids/BDPARCELLAIRE.json",
        "top_level": "0",
        "bottom_level": "15"
      }
    ],
    "extra_crs": ["EPSG:4326"],
    "wms": {
      "enabled": true
    },
    "wmts": {
      "enabled": true
    },
    "tms": {
      "enabled": false
    },
    "ogcapi": {
      "enabled": true
    },
    "styles": [
      "normal"
    ],
    "get_feature_info": {
      "type": "PYRAMID"
    }
  }
}

assert {
  res.status: eq 204
}
