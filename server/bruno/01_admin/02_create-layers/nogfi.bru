meta {
  name: Création de la couche 'nogfi'
  type: http
  seq: 1
}

post {
  url: {{endpoint}}/admin/layers/nogfi
  body: json
  auth: none
}

body:json {
  {
    "title": "nogfi",
    "abstract": "nogfi",
    "keywords": ["nogfi"],
    "pyramids": [
      {
        "path": "s3://pyramids/BDORTHO.json",
        "top_level": "13",
        "bottom_level": "15"
      }
    ],
    "wms": {
      "enabled": true
    },
    "wmts": {
      "enabled": true
    },
    "tms": {
      "enabled": true
    },
    "ogcapi": {
      "enabled": true
    },
    "styles": [
      "normal"
    ]
  }
}

assert {
  res.status: eq 204
}
