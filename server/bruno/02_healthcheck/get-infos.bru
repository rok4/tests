  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.layers: isArray 
  res.body.layers: length 7
  res.body.styles: isArray 
  res.body.styles: length 8
  res.body.tms: isArray 
  res.body.tms: length 2
}
