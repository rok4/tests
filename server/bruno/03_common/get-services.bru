meta {
  name: Racine des services
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/common
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.title: isString 
  res.body.description: isString 
  res.body.links: isArray 
}
