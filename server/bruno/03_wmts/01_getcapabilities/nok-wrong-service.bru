meta {
  name: NOK avec SERVICE erroné
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wmts?REQUEST=GetCapabilities&VERSION=1.0.0&SERVICE=toto
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains exceptionCode="InvalidParameterValue"
}
