meta {
  name: NOK INFOFORMAT avec caractère interdit (chevron)
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=bdparcellaire&TILEMATRIXSET=PM_0_18&TILEMATRIX=13&TILEROW=3758&TILECOL=2706&FORMAT=image/png>&STYLE=normal
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains "Format unknown"
}

