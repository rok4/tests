meta {
  name: NOK 3 couches
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=-6794112.824536955915,1654991.987842774251,-6792234.527173242532,1656519.529396269703&CRS=EPSG:3857&WIDTH=1072&HEIGHT=871&LAYERS=bdortho,bdparcellaire,bdparcellaire&STYLES=normal,orange,blanc&FORMAT=image/jpeg
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains code="InvalidParameterValue"
  res.body: contains "Number of layers exceed the limit (2)"
}
