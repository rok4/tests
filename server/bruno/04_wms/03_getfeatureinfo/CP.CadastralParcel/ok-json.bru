meta {
  name: OK JSON
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&BBOX=14.70227677512375841,-61.03786747840805305,14.70363344876996514,-61.03646487825526634&CRS=EPSG:4326&WIDTH=2&HEIGHT=2&LAYERS=CP.CadastralParcel&STYLES=&FORMAT=image/jpeg&QUERY_LAYERS=CP.CadastralParcel&INFO_FORMAT=application/json&I=0&J=1&FEATURE_COUNT=10
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq FeatureCollection
  res.body.features: isArray
  res.body.features[0]: isJson
  res.body.features[0].type: eq Feature
  res.body.features[0].properties: isJson
  res.body.features[0].properties.pixel: isArray
  res.body.features[0].properties.pixel: length 1
  res.body.features[0].properties.pixel[0]: eq "247"
}

