meta {
  name: NOK sans TILEMATRIXSET
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=alti&TILEMATRIX=13&TILEROW=3760&TILECOL=2705&FORMAT=image/x-bil;bits=32&STYLE=normal
