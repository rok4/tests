meta {
  name: NOK sans LAYER
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&TILEMATRIXSET=PM_0_13&TILEMATRIX=13&TILEROW=3760&FORMAT=image/x-bil;bits=32&STYLE=normal
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains exceptionCode="MissingParameterValue"
}

