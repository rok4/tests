meta {
  name: OK JSON
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetFeatureInfo&VERSION=1.0.0&LAYER=CP.CadastralParcel&STYLE=inspire_common:DEFAULT&INFOFORMAT=application/json&TILEMATRIXSET=PM_0_15&TILEMATRIX=11&TILEROW=939&TILECOL=676&I=102&J=31
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq FeatureCollection
  res.body.features: isArray
  res.body.features[0]: isJson
  res.body.features[0].type: eq Feature
  res.body.features[0].properties: isJson
  res.body.features[0].properties.pixel: isArray
  res.body.features[0].properties.pixel: length 1
  res.body.features[0].properties.pixel[0]: eq "255"
}

