meta {
  name: NOK avec TILECOL non entier
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetFeatureInfo&VERSION=1.0.0&LAYER=alti&TILEMATRIXSET=PM_0_13&TILEMATRIX=13&TILEROW=3760&TILECOL=toto&FORMAT=image/x-bil;bits=32&STYLE=normal
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains exceptionCode="InvalidParameterValue"
}

