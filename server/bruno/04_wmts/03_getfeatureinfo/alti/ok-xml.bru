meta {
  name: OK XML
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetFeatureInfo&VERSION=1.0.0&LAYER=alti&TILEMATRIXSET=PM_0_13&TILEMATRIX=13&TILEROW=3758&TILECOL=2706&I=190&J=95&FORMAT=image/x-bil;bits=32&STYLE=normal&INFOFORMAT=text/xml
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq text/xml
  res.body: contains "<Pixel><Band>316.38</Band></Pixel>"
}

