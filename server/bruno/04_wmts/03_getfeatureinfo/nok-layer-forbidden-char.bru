meta {
  name: NOK LAYER avec caractère interdit (chevron)
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetFeatureInfo&VERSION=1.0.0&LAYER=toto<&TILEMATRIXSET=PM_0_18&TILEMATRIX=13&TILEROW=3758&TILECOL=2706&I=190&J=95&FORMAT=image/png&STYLE=normal&INFOFORMAT=application/json
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains "Layer unknown"
}

