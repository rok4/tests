meta {
  name: OK avec filename
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/tms/1.0.0/bdortho/13/2705/3760.jpeg?filename=toto.jpg
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/jpeg
  res.headers["content-disposition"]: eq attachment; filename="toto.jpg"
}
