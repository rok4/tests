meta {
  name: NOK avec VERSION erronée
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wms?REQUEST=GetCapabilities&VERSION=1.1.1&SERVICE=WMS
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains code="VersionNegotiationFailed"
}
