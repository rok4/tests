meta {
  name: OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wms?REQUEST=GetCapabilities&VERSION=1.3.0&SERVICE=WMS
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq text/xml
  res.body: contains <Name>bdortho</Name>
  res.body: contains <Attribution><Title>titre</Title><OnlineResource xlink:href="url" xlink:type="simple"/><LogoURL width="100" height="100"><Format>image/png</Format><OnlineResource xlink:href="logo_url" xlink:type="simple"/></LogoURL></Attribution>
  res.body: contains <Name>bdparcellaire</Name>
  res.body: contains <Name>pente</Name>
  res.body: contains <Name>alti</Name>
  res.body: contains <Name>CP.CadastralParcel</Name>
  res.body: notContains <Name>limadm</Name>
}