meta {
  name: NOK sans BBOX
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&CRS=EPSG:4326&WIDTH=641&HEIGHT=733&LAYERS=CP.CadastralParcel&STYLES=CP.CadastralParcel.Default&FORMAT=image/png
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains code="MissingParameterValue"
}
