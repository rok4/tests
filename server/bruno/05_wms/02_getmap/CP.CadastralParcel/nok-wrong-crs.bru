meta {
  name: NOK avec CRS erroné
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=14.37083397340628999,-61.24877929687448841,14.92355439904350156,-60.76538085937448841&CRS=TOTO:4326&WIDTH=641&HEIGHT=733&LAYERS=CP.CadastralParcel&STYLES=CP.CadastralParcel.Default&FORMAT=image/png
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains code="InvalidParameterValue"
  res.body: contains CRS TOTO:4326 unknown
}

