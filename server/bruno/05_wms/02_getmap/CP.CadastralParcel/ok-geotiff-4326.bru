meta {
  name: OK (4326 + GEOTIFF)
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=14.37083397340628999,-61.24877929687448841,14.92355439904350156,-60.76538085937448841&CRS=EPSG:4326&WIDTH=641&HEIGHT=733&LAYERS=CP.CadastralParcel&STYLES=inspire_common:DEFAULT&FORMAT=image/geotiff
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/geotiff
}
