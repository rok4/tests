meta {
  name: NOK avec CRS indisponible
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=688361.6354107302614,1589455.748751906678,740980.202359538991,1651078.421579732792&CRS=EPSG:4559&WIDTH=641&HEIGHT=733&LAYERS=OI.OrthoimageCoverage&STYLES=inspire_common:DEFAULT&FORMAT=image/png
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains code="InvalidParameterValue"
  res.body: contains "CRS is not available for the layer"
}

