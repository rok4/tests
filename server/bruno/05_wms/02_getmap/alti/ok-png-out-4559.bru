meta {
  name: OK (4559 + PNG + HYPSO)
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&BBOX=0,0,1000,1000&CRS=EPSG:4559&WIDTH=1000&HEIGHT=1000&LAYERS=alti&STYLES=hypso&FORMAT=image/png
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/png
}
