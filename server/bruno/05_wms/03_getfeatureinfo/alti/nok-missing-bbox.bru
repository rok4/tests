meta {
  name: NOK sans BBOX
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wms?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetFeatureInfo&CRS=EPSG:4559&WIDTH=1071&HEIGHT=871&LAYERS=alti&STYLES=hypso&FORMAT=image/png&QUERY_LAYERS=alti&INFO_FORMAT=text/html&I=508&J=274&FEATURE_COUNT=10
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains code="MissingParameterValue"
  res.body: contains BBOX
}
