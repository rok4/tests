meta {
  name: NOK format erroné
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/ogcapi/api/tileMatrixSets?f=text/xml
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq Format unknown
  res.body.status: eq 400
}
