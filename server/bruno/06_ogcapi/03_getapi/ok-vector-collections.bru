meta {
  name: Collections vecteur OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/ogcapi/api/vectorTiles-collections?f=json
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq "enum"
  res.body.enum: isArray
  res.body.enum: length 1
}
