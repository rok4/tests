meta {
  name: OK (PM)
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/ogcapi/tileMatrixSets/PM?f=json
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.crs: isString
  res.body.id: eq PM
  res.body.tileMatrices: length 22
}
