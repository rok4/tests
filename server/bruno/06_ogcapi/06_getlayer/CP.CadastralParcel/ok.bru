meta {
  name: OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/ogcapi/collections/CP.CadastralParcel?f=json
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.dataType: map
  res.body.id: eq CP.CadastralParcel
  res.body.links: isArray
  res.body.crs: isArray
  res.body.maxCellSize: isNumber
  res.body.minCellSize: isNumber
  res.body.extent.spatial.bbox: isArray
  res.body.extent.spatial.bbox[0]: isArray
  res.body.extent.spatial.bbox[0]: length 4
}
