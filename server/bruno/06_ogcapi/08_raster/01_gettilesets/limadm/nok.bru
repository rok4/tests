meta {
  name: NOK mauvaise route pour les tuiles vecteur
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/ogcapi/collections/limadm/map/tiles?f=json
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq "Vector dataset have to be requested without map"
  res.body.status: eq 400
}