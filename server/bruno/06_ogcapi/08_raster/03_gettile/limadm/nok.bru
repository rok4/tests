meta {
  name: NOK mauvaise route pour les tuiles vecteur
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/ogcapi/collections/limadm/styles/normal/map/tiles/PM_10_18/12/1879/1353?f=mvt
  body: none
  auth: none
}

params:query {
  f: mvt
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq "Vector dataset have to be requested with tiles request"
  res.body.status: eq 400
}
