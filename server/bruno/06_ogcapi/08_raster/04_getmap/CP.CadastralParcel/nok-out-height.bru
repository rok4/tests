meta {
  name: NOK avec HEIGHT erroné (trop grand)
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/ogcapi/collections/CP.CadastralParcel/styles/CP.CadastralParcel.Default/map?bbox=14.37083397340628999,-61.24877929687448841,14.92355439904350156,-60.76538085937448841&crs=EPSG:4326&bbox-crs=EPSG:4326&width=641&height=5001&f=png
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body.type: eq InvalidParameter
  res.body.title: contains "height query parameter exceed the limit (5000)"
}

