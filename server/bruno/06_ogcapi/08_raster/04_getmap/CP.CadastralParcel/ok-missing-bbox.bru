meta {
  name: OK sans BBOX
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/ogcapi/collections/CP.CadastralParcel/styles/CP.CadastralParcel.Default/map?crs=EPSG:4326&bbox-crs=EPSG:4326&width=641&height=733&f=png
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/png
}
