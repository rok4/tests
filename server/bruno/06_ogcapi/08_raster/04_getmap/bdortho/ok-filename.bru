meta {
  name: OK (4326 + GEOTIFF DEFLATE)
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/ogcapi/collections/bdortho/styles/normal/map?bbox=-6818182.923037664965,1616796.022287987173,-6764371.25512490049,1680391.629821252078&crs=EPSG:3857&bbox-crs=EPSG:3857&width=691&height=815&f=tiff&filename=toto.tif
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/geotiff
  res.headers["content-disposition"]: eq attachment; filename="toto.tif"
}
