meta {
  name: NOK format avec caractère interdit (double quotes)
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/ogcapi/collections/limadm/tiles?f=toto"
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq Format unknown
  res.body.status: eq 400
}

