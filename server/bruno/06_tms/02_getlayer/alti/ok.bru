meta {
  name: OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/tms/1.0.0/alti
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq text/xml
  res.body: contains <Title>alti</Title>
  res.body: contains <TileFormat width="256" height="256" mime-type="image/x-bil;bits=32" extension="zbil"/>
}
