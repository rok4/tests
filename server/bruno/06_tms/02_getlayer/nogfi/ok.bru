meta {
  name: OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/tms/1.0.0/nogfi
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq text/xml
  res.body: contains <Title>nogfi</Title>
  res.body: contains <TileFormat width="256" height="256" mime-type="image/jpeg" extension="jpeg"/>
}
