meta {
  name: OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/tiles/collections?f=application/json
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.collections: isArray
  res.body.collections: length 6
  res.body.links: isArray
}
