meta {
  name: NOK mauvaise route pour les tuiles raster
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/tiles/collections/pente/tiles?f=application/json
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq "Raster dataset have to be requested with style"
  res.body.status: eq 400
}