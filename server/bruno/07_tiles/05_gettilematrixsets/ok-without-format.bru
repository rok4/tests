meta {
  name: OK sans préciser le format
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/tiles/tileMatrixSets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.tileMatrixSets: isArray
  res.body.tileMatrixSets: length 2
  res.body.tileMatrixSets[0].links: isArray
}
