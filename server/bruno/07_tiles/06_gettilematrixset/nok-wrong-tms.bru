meta {
  name: NOK tms erroné
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/tiles/tileMatrixSets/toto?f=application/json
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq ResourceNotFound
  res.body.title: eq Tile matrix set toto unknown
}

