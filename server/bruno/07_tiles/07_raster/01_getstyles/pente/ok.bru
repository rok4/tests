meta {
  name: OK
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/tiles/collections/pente/styles
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.links: isArray
  res.body.styles: length 2
  res.body.title: isString
}