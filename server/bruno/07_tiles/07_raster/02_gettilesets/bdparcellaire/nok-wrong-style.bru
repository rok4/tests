meta {
  name: NOK style erroné
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/tiles/collections/bdparcellaire/styles/hypso/map/tiles?f=json
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq Style hypso unknown
  res.body.status: eq 400
}

