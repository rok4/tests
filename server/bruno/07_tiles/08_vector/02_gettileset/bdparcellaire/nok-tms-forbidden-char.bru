meta {
  name: NOK TMS avec caractère interdit (double quote)
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/tiles/collections/bdparcellaire/styles/orange/map/tiles/toto"?f=json
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq application/json
  res.body: isJson
  res.body.type: eq InvalidParameter
  res.body.title: eq Tile matrix set unknown
  res.body.status: eq 400
}

