meta {
  name: NOK STYLE avec caractère interdit (double quote)
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/tiles/collections/bdparcellaire/styles/orange"/map/tiles/PM_0_18/16/30066/21659?f=png
  body: none
