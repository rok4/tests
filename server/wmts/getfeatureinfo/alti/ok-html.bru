meta {
  name: OK HTML
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetFeatureInfo&VERSION=1.0.0&LAYER=alti&TILEMATRIXSET=PM_0_13&TILEMATRIX=13&TILEROW=3758&TILECOL=2706&I=190&J=95&FORMAT=image/x-bil;bits=32&STYLE=normal&INFOFORMAT=text/html
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq text/html
  res.body: contains "<html><body><p><b>Pixel value :</b></p></body><ul><li>316.38</li></ul></html>"
}

