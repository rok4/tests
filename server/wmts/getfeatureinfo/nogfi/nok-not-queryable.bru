meta {
  name: NOK pas de GFI configuré
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetFeatureInfo&VERSION=1.0.0&LAYER=nogfi&TILEMATRIXSET=PM_0_15&TILEMATRIX=13&TILEROW=3758&TILECOL=2706&I=190&J=95&FORMAT=image/jpeg&STYLE=normal&INFOFORMAT=application/json
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains exceptionCode="InvalidParameterValue"
  res.body: contains not queryable
}

