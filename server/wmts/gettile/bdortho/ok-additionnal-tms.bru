meta {
  name: OK selon un TMS additionnel
  type: http
  seq: 1
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=bdortho&TILEMATRIXSET=4326_0_15&TILEMATRIX=10&TILEROW=428&TILECOL=678&FORMAT=image/jpeg&STYLE=normal
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.headers["content-type"]: eq image/jpeg
}