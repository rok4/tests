meta {
  name: NOK sur une couche vecteur en WMTS
  type: http
  seq: 2
}

get {
  url: {{endpoint}}/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=limadm&TILEMATRIXSET=PM_0_15&TILEMATRIX=13&TILEROW=3760&TILECOL=2705&FORMAT=image/jpeg&STYLE=normal
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.headers["content-type"]: eq text/xml
  res.body: contains exceptionCode="InvalidParameterValue"
}

